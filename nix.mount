[Unit]
Description=Bind mount persistent Nix store (/var/nix -> /nix)
Documentation=https://nixos.org/manual/nix/stable/installation/installing-binary
# /var/nix must be available (local filesystems up) before the bind mount.
After=local-fs.target
Before=nix-daemon.socket start-nix-socket.service

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind
# If /var/nix is missing/corrupt, boot must not fall back to a broken /nix.
DirectoryMode=0755

[Install]
WantedBy=local-fs.target
