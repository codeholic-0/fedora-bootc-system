FROM quay.io/fedora/fedora-bootc:45
ENV FEDORA_VER="45"

# ---------------------------------------------------------------------------
# 1) System-wide metadata
# ---------------------------------------------------------------------------
# Keep the KDE product identity (swapped in with --allowerasing below).
RUN dnf -y install --allowerasing \
        fedora-release-kde-desktop \
        fedora-release-identity-kde-desktop \
    && dnf clean all

# ---------------------------------------------------------------------------
# 2) dnf plugins & repos
# ---------------------------------------------------------------------------
# dnf-plugins-core FIRST: the bootc base has no dnf plugin packages, but the
# copr/config-manager/setopt commands below all require them.
RUN dnf -y install dnf-plugins-core dnf5-plugins

RUN dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$FEDORA_VER.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$FEDORA_VER.noarch.rpm" \
    && dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf copr enable imput/helium -y \
    && dnf config-manager setopt 'rpmfusion-free.enabled=1' 'rpmfusion-free-updates.enabled=1' \
        'rpmfusion-nonfree.enabled=1' 'rpmfusion-nonfree-updates.enabled=1' \
    && dnf config-manager setopt fedora-cisco-openh264.enabled=1 \
    && dnf install -y --refresh rpmfusion-free-release-tainted rpmfusion-nonfree-release-tainted \
    && dnf makecache

# ---------------------------------------------------------------------------
# 3) Codecs & multimedia framework
# ---------------------------------------------------------------------------
# @multimedia pulls the full gstreamer plugin set + codec libs; nothing else
# needed here. Everything listed below is plugin support, so one group.
RUN dnf -y group install multimedia && dnf clean all

# ---------------------------------------------------------------------------
# 4) KDE Plasma desktop (core)
# ---------------------------------------------------------------------------
# Top-level only: kwin/plasma-* dependencies resolve themselves.
RUN dnf -y install \
        kwin \
        plasma-desktop \
        plasma-workspace \
        plasma-lookandfeel-fedora \
        plasma-keyboard \
        plasma-thunderbolt \
        plasma-disks \
        plasma-vault \
        plasma-systemsettings \
        plasma-nm \
        plasma-pa \
        plasma-print-manager \
        plasma-browser-integration \
        kdeplasma-addons \
        bluedevil \
        polkit-kde \
        kde-gtk-config \
        ocean-sound-theme \
        xdg-desktop-portal-kde \
        kcm-plasma-keyboard \
        plasma-login-manager \
        kcm-plasmalogin \
    && dnf clean all

# ---------------------------------------------------------------------------
# 5) KDE applications
# ---------------------------------------------------------------------------
RUN dnf -y install \
        konsole \
        dolphin \
        dolphin-plugins \
        kate \
        ark \
        kfind \
        kdialog \
        kcalc \
        filelight \
        spectacle \
        kinfocenter \
        kwalletmanager5 \
        krdp \
        kio-extras \
        kio-admin \
        kio-fuse \
        kio-gdrive \
        kdenetwork-filesharing \
        kde-connect \
        kde-partitionmanager \
        kscreen \
    && dnf clean all

# ---------------------------------------------------------------------------
# 6) Desktop extras (system frameworks pulled in by KDE apps)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        accountsservice \
        colord \
        colord-kde \
        desktop-backgrounds-kde \
        desktop-file-utils \
        kde-settings \
        redhat-menus \
    && dnf clean all

# ---------------------------------------------------------------------------
# 7) Fonts
# ---------------------------------------------------------------------------
# Base image ships the Noto/DejaVu/Adwaita core; all locale default-fonts-*
# subpackages come with it. Explicitly kept: classic fallback families, the
# CJK pair, emoji, the personal typing fonts, plus a dedicated terminal font.
RUN dnf -y install \
        liberation-fonts-all \
        google-noto-sans-fonts \
        google-noto-serif-fonts \
        google-noto-sans-cjk-vf-fonts \
        google-noto-serif-cjk-vf-fonts \
        google-noto-color-emoji-fonts \
        rit-meera-new-fonts \
        rit-rachana-fonts \
        source-foundry-hack-fonts \
    && dnf clean all

# ---------------------------------------------------------------------------
# 8) Input (ibus)
# ---------------------------------------------------------------------------
# Kept engine-agnostic: ibus + m17n (covers AS/multi-script schemes) and the
# typing-booster character predictor. CJK specific engines (anthy, chewing,
# hangul, libpinyin, table-* ) intentionally excluded.
RUN dnf -y install \
        ibus \
        ibus-m17n \
        ibus-typing-booster \
        langtable \
        kxkb2locale1 \
    && dnf clean all

# ---------------------------------------------------------------------------
# 9) Audio stack
# ---------------------------------------------------------------------------
# instances pulse out of plasma-pa; pulseaudio-utils gives pactl/padsp for CLI.
RUN dnf -y install \
        wireplumber \
        pulseaudio-utils \
        alsa-utils \
        alsa-ucm \
        alsa-sof-firmware \
    && dnf clean all

# ---------------------------------------------------------------------------
# 10) Media, imaging & personal apps
# ---------------------------------------------------------------------------
RUN dnf -y install \
        helium-bin \
        persepolis \
        mediawriter \
        keepassxc \
        vlc \
        yt-dlp \
        zenity \
        guvcview \
    && dnf clean all

# ---------------------------------------------------------------------------
# 11) Network — core, wifi/bluetooth/wwan, VPN
# ---------------------------------------------------------------------------
RUN dnf -y install \
        NetworkManager \
        NetworkManager-wifi \
        NetworkManager-bluetooth \
        NetworkManager-wwan \
        NetworkManager-config-connectivity-fedora \
        NetworkManager-openvpn \
        NetworkManager-openconnect \
        NetworkManager-pptp \
        NetworkManager-l2tp \
        NetworkManager-libreswan \
        vpnc-script \
        openssh-server \
        openssh-clients \
        bind-utils \
        ethtool \
        iw \
    && dnf clean all

# ---------------------------------------------------------------------------
# 12) Bluetooth extras (explicit per system requirement)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        bluez \
        bluez-obexd \
        iwlbluetooth-firmware \
        brcmfmac-firmware \
        atheros-firmware \
        nxpwireless-firmware \
        mt7xxx-firmware \
        iwlegacy-firmware \
        realtek-firmware \
        wireless-regdb \
    && dnf clean all

# ---------------------------------------------------------------------------
# 13) Containers
# ---------------------------------------------------------------------------
RUN dnf -y install \
        docker-ce \
        docker-compose-plugin \
        docker-buildx-plugin \
        podman \
        flatpak \
        fedora-flathub-remote \
        fedora-workstation-repositories \
        fedora-third-party \
    && dnf clean all

# ---------------------------------------------------------------------------
# 14) Printing & scanning
# ---------------------------------------------------------------------------
RUN dnf -y install \
        cups \
        cups-filters \
        cups-filters-driverless \
        hplip \
        sane-backends \
        sane-airscan \
        ipp-usb \
        ghostscript \
    && dnf clean all

# ---------------------------------------------------------------------------
# 15) Filesystem & storage tools
# ---------------------------------------------------------------------------
RUN dnf -y install \
        btrfs-progs \
        ntfs-3g \
        exfatprogs \
        e2fsprogs \
        dosfstools \
        xfsprogs \
        f2fs-tools \
        parted \
        gocryptfs \
        cryfs \
        fuse-sshfs \
        cifs-utils \
        samba \
        samba-usershares \
    && dnf clean all

# ---------------------------------------------------------------------------
# 16) System services & power/security
# ---------------------------------------------------------------------------
RUN dnf -y install \
        firewalld \
        firewall-config \
        earlyoom \
        thermald \
        fwupd \
        smartmontools \
        pciutils \
        usbutils \
        i2c-tools \
        lm_sensors \
        chrony \
        tuned \
        switcheroo-control \
        bluez-cups \
        fprintd \
        pcsc-lite \
        opensc \
    && dnf clean all

# ---------------------------------------------------------------------------
# 17) Developer tools
# ---------------------------------------------------------------------------
RUN dnf -y install \
        git \
        vim-enhanced \
        nano \
        zsh \
        gcc \
        make \
        ninja-build \
        glibc-devel \
        kernel-headers \
    && dnf clean all

# ---------------------------------------------------------------------------
# 18) CLI utilities
# ---------------------------------------------------------------------------
RUN dnf -y install \
        btop \
        fastfetch \
        fzf \
        ripgrep \
        bat \
        fd-find \
        eza \
        jq \
        zoxide \
        plocate \
        tree \
        bc \
        rsync \
        socat \
        nmap-ncat \
        tcpdump \
        traceroute \
        mtr \
        dos2unix \
        7zip \
        zip \
        unar \
        wget2 \
        curl \
        which \
        sudo \
        lsof \
        ImageMagick \
        ImageMagick-libs \
    && dnf clean all

# ---------------------------------------------------------------------------
# 19) Vulkan & graphics CLI
# ---------------------------------------------------------------------------
RUN dnf -y install \
        vulkan-tools \
        glx-utils \
        libva-utils \
    && dnf clean all

# ---------------------------------------------------------------------------
# 20) i18n / locale
# ---------------------------------------------------------------------------
RUN dnf -y install \
        glibc-all-langpacks \
        hunspell \
        hunspell-en \
    && dnf clean all

# ---------------------------------------------------------------------------
# 21) Enable Services
# ---------------------------------------------------------------------------
RUN systemctl enable NetworkManager.service plasmalogin.service docker.service earlyoom.service -f

# Testing 
RUN rpm -qa --queryformat='%{NAME} \n' | sort -u