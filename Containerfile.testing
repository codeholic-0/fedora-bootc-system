FROM quay.io/fedora/fedora-bootc:45
ENV FEDORA_VER="45"

# dnf-plugins-core FIRST: the bootc base has no dnf plugin packages, but the
# copr/config-manager/setopt commands below all require them.
RUN dnf -y install dnf-plugins-core dnf5-plugins

# Add Repos; Enable; Update Cache
RUN dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$FEDORA_VER.noarch.rpm" \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$FEDORA_VER.noarch.rpm" \
    && dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf copr enable imput/helium -y \
    && dnf config-manager setopt 'rpmfusion-free.enabled=1' 'rpmfusion-free-updates.enabled=1' \
        'rpmfusion-nonfree.enabled=1' 'rpmfusion-nonfree-updates.enabled=1' \
    && dnf config-manager setopt fedora-cisco-openh264.enabled=1 \
    && dnf install -y --refresh rpmfusion-free-release-tainted rpmfusion-nonfree-release-tainted \
    && dnf makecache

# Graphical groups as a safety net (most of these pkgs are also in the full list)
RUN dnf -y group install kde-desktop \
    && dnf -y group install multimedia

# Full package set replicated from `rpm -qa` of the source Fedora KDE system.
# Filtered OUT: codium, zen-browser (helium only), the VM stack (qemu/libvirt/
# virt-*/xen/swtpm/edk2/spice/nbdkit/passt...), wine+winetricks+mingw, dosbox-
# staging, EDA tools (iverilog/verilator/gtkwave), bootc-managed boot bits
# (kernel images, grub2, shim, efibootmgr, efivar, dracut, memstrack, kexec,
# microcode_ctl, mokutil, os-prober, yama-ptrace-enable), gpg-pubkey (rpm db
# key entry, not installable), and the "+"-suffixed provides.
# --allowerasing: swaps the -free ffmpeg libs out for RPM Fusion's, and
# resolves the fedora-release identity (kde) package vs the base image.
RUN dnf -y install --allowerasing \
        7zip \
        aajohan-comfortaa-fonts \
        aalib-libs \
        aardvark-dns \
        abattis-cantarell-fonts \
        abattis-cantarell-vf-fonts \
        abseil-cpp \
        accounts-qml-module-qt6 \
        accountsservice \
        accountsservice-libs \
        acl \
        add-determinism \
        adobe-mappings-cmap \
        adobe-mappings-cmap-deprecated \
        adobe-mappings-pdf \
        adwaita-cursor-theme \
        adwaita-icon-theme \
        adwaita-icon-theme-legacy \
        adwaita-mono-fonts \
        adwaita-sans-fonts \
        aha \
        alsa-lib \
        alsa-sof-firmware \
        alsa-ucm \
        alsa-utils \
        alternatives \
