FROM quay.io/fedora/fedora-bootc:45
ENV FEDORA_VER="45"

# ---------------------------------------------------------------------------
# 1) System-wide metadata
# ---------------------------------------------------------------------------
# Keep the KDE product identity (swapped in with --allowerasing below).
RUN dnf -y install --allowerasing \
        fedora-release-kde-desktop \
        fedora-release-identity-kde-desktop \
    && dnf clean all

# ---------------------------------------------------------------------------
# 2) dnf plugins & repos
# ---------------------------------------------------------------------------
# dnf-plugins-core FIRST: the bootc base has no dnf plugin packages, but the
# copr/config-manager/setopt commands below all require them.
RUN dnf -y install dnf-plugins-core dnf5-plugins

RUN dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$FEDORA_VER.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$FEDORA_VER.noarch.rpm" \
    && dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf copr enable imput/helium -y \
    && dnf config-manager setopt 'rpmfusion-free.enabled=1' 'rpmfusion-free-updates.enabled=1' \
        'rpmfusion-nonfree.enabled=1' 'rpmfusion-nonfree-updates.enabled=1' \
    && dnf config-manager setopt fedora-cisco-openh264.enabled=1 \
    && dnf install -y --refresh rpmfusion-free-release-tainted rpmfusion-nonfree-release-tainted \
    && dnf makecache

# ---------------------------------------------------------------------------
# 3) Bridged repos for the ISO depsolver
# ---------------------------------------------------------------------------
# The bootc base ships its distro repo definitions in /usr/share/dnf5/repos.d/
# (dnf5 "system repos"). bootc-image-builder's osbuild depsolver only reads the
# classic /etc/yum.repos.d/, so copy the definitions over or anaconda-iso
# builds fail with "No match for argument: <base package>".
RUN cp /usr/share/dnf5/repos.d/*.repo /etc/yum.repos.d/ \
    && dnf clean all

# ---------------------------------------------------------------------------
# 4) Codecs & multimedia framework
# ---------------------------------------------------------------------------
# @multimedia pulls the full gstreamer plugin set + codec libs; nothing else
# needed here. Everything listed below is plugin support, so one group.
RUN dnf -y group install multimedia && dnf clean all

# ---------------------------------------------------------------------------
# 5) KDE Plasma desktop (core, minimized)
# ---------------------------------------------------------------------------
# Irreducible core + the settings/UI modules that matter. Everything else is
# dropped in favor of /nix (home-manager) or being simply unused.
RUN dnf -y install \
        kwin \
        plasma-desktop \
        plasma-workspace \
        plasma-lookandfeel-fedora \
        plasma-keyboard \
        plasma-thunderbolt \
        plasma-systemsettings \
        plasma-nm \
        plasma-pa \
        plasma-print-manager \
        kdeplasma-addons \
        plasma-drkonqi \
        bluedevil \
        polkit-kde \
        kde-gtk-config \
        ocean-sound-theme \
        xdg-desktop-portal-kde \
        kcm-plasma-keyboard \
        flatpak-kcm \
        ksshaskpass \
        pinentry-qt \
        pam-kwallet \
        plasma-login-manager \
        kcm-plasmalogin \
    && dnf clean all

# ---------------------------------------------------------------------------
# 6) KDE applications (minimized)
# ---------------------------------------------------------------------------
# konsole/dolphin/kate per system contract; spectacle, kinfocenter, kscreen are
# basic daily-driver pieces. kfind/kcalc/kdialog/filelight are tiny utilities.
RUN dnf -y install \
        konsole \
        dolphin \
        dolphin-plugins \
        kate \
        ark \
        kfind \
        kdialog \
        kcalc \
        filelight \
        spectacle \
        kinfocenter \
        kwalletmanager5 \
        kio-extras \
        kio-admin \
        kio-fuse \
        kdnssd \
        kdegraphics-thumbnailers \
        kdenetwork-filesharing \
        kscreen \
    && dnf clean all

# ---------------------------------------------------------------------------
# 7) Desktop extras (system frameworks pulled in by KDE apps)
# ---------------------------------------------------------------------------
# kde-settings-pulseaudio wires KDE audio defaults; libappindicator-gtk3 gives
# systray icons for Electron apps.
RUN dnf -y install \
        accountsservice \
        colord \
        colord-kde \
        desktop-backgrounds-kde \
        desktop-file-utils \
        kde-settings \
        kde-settings-pulseaudio \
        libappindicator-gtk3 \
        redhat-menus \
    && dnf clean all

# ---------------------------------------------------------------------------
# 8) Fonts
# ---------------------------------------------------------------------------
# Base image ships the Noto/DejaVu/Adwaita core; all locale default-fonts-*
# subpackages come with it. CJK pair intentionally dropped (unused, ~200MB).
RUN dnf -y install \
        liberation-fonts-all \
        google-noto-sans-fonts \
        google-noto-serif-fonts \
        google-noto-color-emoji-fonts \
        rit-meera-new-fonts \
        rit-rachana-fonts \
        source-foundry-hack-fonts \
    && dnf clean all

# ---------------------------------------------------------------------------
# 9) Input (ibus)
# ---------------------------------------------------------------------------
# Kept engine-agnostic: ibus + m17n (covers AS/multi-script schemes) and the
# typing-booster character predictor. ibus-gtk4 is required for input methods
# to work inside GTK4 apps. CJK engines intentionally excluded.
RUN dnf -y install \
        ibus \
        ibus-gtk4 \
        ibus-m17n \
        ibus-typing-booster \
        langtable \
        kxkb2locale1 \
    && dnf clean all

# ---------------------------------------------------------------------------
# 10) Audio stack
# ---------------------------------------------------------------------------
# instances pulse out of plasma-pa; pulseaudio-utils gives pactl/padsp for CLI.
# phonon(+vlc backend) is the KDE media framework some widgets/apps use.
RUN dnf -y install \
        wireplumber \
        pulseaudio-utils \
        alsa-utils \
        alsa-ucm \
        alsa-sof-firmware \
        phonon-qt6 \
        phonon-qt6-backend-vlc \
    && dnf clean all

# ---------------------------------------------------------------------------
# 11) Plymouth boot splash
# ---------------------------------------------------------------------------
# Basics + the Breeze theme to match the desktop. plymouth-system-theme pulls
# the plugin/graphic-libs set; the kargs side lives in plymouth.toml (rhgb quiet).
RUN dnf -y install \
        plymouth \
        plymouth-system-theme \
        plymouth-theme-breeze \
    && dnf clean all

RUN plymouth-set-default-theme breeze

# ---------------------------------------------------------------------------
# 12) Nix store (bind mounted from /var/nix at boot)
# ---------------------------------------------------------------------------
# /var/nix lives on the mutable part of the disk; /nix is read-only in a bootc
# image, so the persistent store is bind mounted in by nix.mount.
# start-nix-socket.service then daemon-reloads and starts nix-daemon.socket.
RUN mkdir -p /nix

# ---------------------------------------------------------------------------
# 13) Hardware support — kernel modules, firmware, boot tooling
# ---------------------------------------------------------------------------
# kernel-modules-extra: additional filesystem/net/misc modules for wider hw.
# iwlwifi-*: Intel Wi-Fi firmware (mvm = modern, dvm = older, mld = newest gen).
# libertas + b43: Marvell / old Broadcom Wi-Fi.
# intel-vsc-firmware: Intel Visual Sensing Controller (MIPI camera).
# intel-lpmd: Intel Low Power daemon for laptop power tuning.
# usb_modeswitch: mode-switching for 3G/4G WWAN USB dongles.
# mcelog: CPU machine-check error reporting. grubby/grub2-tools: kernel arg
# management; zram-generator-defaults supplies the default zram config.
RUN dnf -y install \
        kernel-modules-extra \
        iwlwifi-mvm-firmware \
        iwlwifi-dvm-firmware \
        iwlwifi-mld-firmware \
        libertas-firmware \
        b43-fwcutter \
        b43-openfwwf \
        intel-vsc-firmware \
        intel-lpmd \
        usb_modeswitch \
        usb_modeswitch-data \
        mcelog \
        grubby \
        grub2-tools-extra \
        grub2-efi-x64-modules \
        zram-generator-defaults \
    && dnf clean all

# ---------------------------------------------------------------------------
# 14) Media, imaging & personal apps
# ---------------------------------------------------------------------------
RUN dnf -y install \
        helium-bin \
        persepolis \
        mediawriter \
        keepassxc \
        vlc \
        gthumb \
        yt-dlp \
        zenity \
        guvcview \
    && dnf clean all

# ---------------------------------------------------------------------------
# 15) Network — core, wifi/bluetooth/wwan
# ---------------------------------------------------------------------------
# VPN plugins/KCMs intentionally excluded (not used; add via /nix if needed).
RUN dnf -y install \
        NetworkManager \
        NetworkManager-wifi \
        NetworkManager-bluetooth \
        NetworkManager-wwan \
        NetworkManager-config-connectivity-fedora \
        openssh-server \
        openssh-clients \
        bind-utils \
        ethtool \
        iw \
    && dnf clean all

# ---------------------------------------------------------------------------
# 16) Bluetooth extras (explicit per system requirement)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        bluez \
        bluez-obexd \
        iwlbluetooth-firmware \
        brcmfmac-firmware \
        atheros-firmware \
        nxpwireless-firmware \
        mt7xxx-firmware \
        iwlegacy-firmware \
        realtek-firmware \
        wireless-regdb \
    && dnf clean all

# ---------------------------------------------------------------------------
# 17) Containers
# ---------------------------------------------------------------------------
RUN dnf -y install \
        docker-ce \
        docker-compose-plugin \
        docker-buildx-plugin \
        podman \
        podman-compose \
        flatpak \
        fedora-flathub-remote \
        fedora-workstation-repositories \
        fedora-third-party \
    && dnf clean all

# ---------------------------------------------------------------------------
# 18) Printing & scanning
# ---------------------------------------------------------------------------
# cups-pk-helper = privileged print-config helper, system-config-printer-udev =
# udev hotplug for USB printers, gutenprint = extra printer driver coverage.
RUN dnf -y install \
        cups \
        cups-filters \
        cups-filters-driverless \
        cups-pk-helper \
        system-config-printer-udev \
        gutenprint \
        gutenprint-cups \
        gutenprint-libs \
        hplip \
        sane-backends \
        sane-airscan \
        ipp-usb \
        ghostscript \
    && dnf clean all

# ---------------------------------------------------------------------------
# 19) Filesystem & storage tools
# ---------------------------------------------------------------------------
# udisks2-btrfs + libblockdev-btrfs add btrfs support to the udisks/KDE stack,
# compsize is a btrfs compression analyzer.
RUN dnf -y install \
        btrfs-progs \
        udisks2-btrfs \
        libblockdev-btrfs \
        compsize \
        ntfs-3g \
        exfatprogs \
        e2fsprogs \
        dosfstools \
        xfsprogs \
        f2fs-tools \
        parted \
        gocryptfs \
        cryfs \
        fuse-sshfs \
        cifs-utils \
        samba \
        samba-usershares \
    && dnf clean all

# ---------------------------------------------------------------------------
# 20) System services & power/security
# ---------------------------------------------------------------------------
# cronie(+anacron)/crontabs = scheduling, audit(+rules) = security logging.
# Both are enabled in the services step below.
RUN dnf -y install \
        firewalld \
        firewall-config \
        earlyoom \
        cronie \
        cronie-anacron \
        crontabs \
        audit \
        audit-rules \
        thermald \
        fwupd \
        smartmontools \
        pciutils \
        usbutils \
        i2c-tools \
        lm_sensors \
        chrony \
        tuned \
        switcheroo-control \
        bluez-cups \
        fprintd \
        pcsc-lite \
        opensc \
    && dnf clean all

# ---------------------------------------------------------------------------
# 21) Shells & rescue tools — dev tooling comes from /nix
# ---------------------------------------------------------------------------
# Compilers/build systems/kernel headers intentionally excluded. git is kept:
# Nix flakes/home-manager fetch sources with it. nano is the TTY rescue editor.
RUN dnf -y install \
        zsh \
        git \
        nano \
        kernel-headers \
    && dnf clean all

# ---------------------------------------------------------------------------
# 22) CLI utilities (rescue kit — everything else comes via /nix)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        btop \
        fastfetch \
        jq \
        tree \
        bc \
        rsync \
        7zip \
        zip \
        wget2 \
        curl \
        which \
        sudo \
        lsof \
        plocate \
        tar \
    && dnf clean all

# ---------------------------------------------------------------------------
# 23) Vulkan & graphics CLI
# ---------------------------------------------------------------------------
RUN dnf -y install \
        vulkan-tools \
        glx-utils \
        libva-utils \
    && dnf clean all

# ---------------------------------------------------------------------------
# 24) i18n / locale
# ---------------------------------------------------------------------------
RUN dnf -y install \
        glibc-all-langpacks \
        hunspell \
        hunspell-en \
    && dnf clean all

# ---------------------------------------------------------------------------
# 25) Enable Services
# ---------------------------------------------------------------------------
RUN systemctl enable NetworkManager.service plasmalogin.service docker.service earlyoom.service crond.service auditd.service -f

# Testing
RUN rpm -qa --queryformat='%{NAME} \n' | sort -u
