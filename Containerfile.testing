FROM quay.io/fedora/fedora-bootc:45
ENV FEDORA_VER="45"

# ---------------------------------------------------------------------------
# 1) System-wide metadata
# ---------------------------------------------------------------------------
# Keep the KDE product identity (swapped in with --allowerasing below).
RUN dnf -y install --allowerasing \
        fedora-release-kde-desktop \
        fedora-release-identity-kde-desktop \
    && dnf clean all

# ---------------------------------------------------------------------------
# 2) dnf plugins & repos
# ---------------------------------------------------------------------------
# dnf-plugins-core FIRST: the bootc base has no dnf plugin packages, but the
# copr/config-manager/setopt commands below all require them.
RUN dnf -y install dnf-plugins-core dnf5-plugins

RUN dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$FEDORA_VER.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$FEDORA_VER.noarch.rpm" \
    && dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf copr enable imput/helium -y \
    && dnf config-manager setopt 'rpmfusion-free.enabled=1' 'rpmfusion-free-updates.enabled=1' \
        'rpmfusion-nonfree.enabled=1' 'rpmfusion-nonfree-updates.enabled=1' \
    && dnf config-manager setopt fedora-cisco-openh264.enabled=1 \
    && dnf install -y --refresh rpmfusion-free-release-tainted rpmfusion-nonfree-release-tainted \
    && dnf makecache

# ---------------------------------------------------------------------------
# 3) Codecs & multimedia framework
# ---------------------------------------------------------------------------
# @multimedia pulls the full gstreamer plugin set + codec libs; nothing else
# needed here. Everything listed below is plugin support, so one group.
RUN dnf -y group install multimedia && dnf clean all

# ---------------------------------------------------------------------------
# 4) KDE Plasma desktop (core)
# ---------------------------------------------------------------------------
# Top-level only: kwin/plasma-* dependencies resolve themselves.
# plasma-nm-* give the System Settings GUIs for the NM VPN plugins installed
# later; drkonqi is the crash handler, ksshaskpass/pinentry-qt/pam-kwallet the
# secrets & askpass integration, flatpak-kcm the Flatpak settings module.
RUN dnf -y install \
        kwin \
        plasma-desktop \
        plasma-workspace \
        plasma-lookandfeel-fedora \
        plasma-keyboard \
        plasma-thunderbolt \
        plasma-disks \
        plasma-vault \
        plasma-systemsettings \
        plasma-nm \
        plasma-nm-openvpn \
        plasma-nm-openconnect \
        plasma-nm-pptp \
        plasma-nm-openswan \
        plasma-pa \
        plasma-print-manager \
        plasma-browser-integration \
        kdeplasma-addons \
        plasma-drkonqi \
        bluedevil \
        polkit-kde \
        kde-gtk-config \
        ocean-sound-theme \
        xdg-desktop-portal-kde \
        kcm-plasma-keyboard \
        flatpak-kcm \
        ksshaskpass \
        pinentry-qt \
        pam-kwallet \
        plasma-login-manager \
        kcm-plasmalogin \
    && dnf clean all

# ---------------------------------------------------------------------------
# 5) KDE applications
# ---------------------------------------------------------------------------
# kjournald = journald viewer, kdebugsettings = debug category config,
# kdegraphics-thumbnailers = image previews in Dolphin, kde-l10n = UI translations.
RUN dnf -y install \
        konsole \
        dolphin \
        dolphin-plugins \
        kate \
        ark \
        kfind \
        kdialog \
        kcalc \
        filelight \
        spectacle \
        kinfocenter \
        kwalletmanager5 \
        krdp \
        kio-extras \
        kio-admin \
        kio-fuse \
        kio-gdrive \
        kdnssd \
        kamera \
        kdegraphics-thumbnailers \
        kdenetwork-filesharing \
        kde-connect \
        kde-partitionmanager \
        kscreen \
        kdebugsettings \
        kjournald \
        kunifiedpush \
        kde-l10n \
    && dnf clean all

# ---------------------------------------------------------------------------
# 6) Desktop extras (system frameworks pulled in by KDE apps)
# ---------------------------------------------------------------------------
# kde-settings-pulseaudio wires KDE audio defaults; libappindicator-gtk3 gives
# systray icons for Electron apps.
RUN dnf -y install \
        accountsservice \
        colord \
        colord-kde \
        desktop-backgrounds-kde \
        desktop-file-utils \
        kde-settings \
        kde-settings-pulseaudio \
        libappindicator-gtk3 \
        redhat-menus \
    && dnf clean all

# ---------------------------------------------------------------------------
# 7) Fonts
# ---------------------------------------------------------------------------
# Base image ships the Noto/DejaVu/Adwaita core; all locale default-fonts-*
# subpackages come with it. Explicitly kept: classic fallback families, the
# CJK pair, emoji, the personal typing fonts, plus a dedicated terminal font.
RUN dnf -y install \
        liberation-fonts-all \
        google-noto-sans-fonts \
        google-noto-serif-fonts \
        google-noto-sans-cjk-vf-fonts \
        google-noto-serif-cjk-vf-fonts \
        google-noto-color-emoji-fonts \
        rit-meera-new-fonts \
        rit-rachana-fonts \
        source-foundry-hack-fonts \
    && dnf clean all

# ---------------------------------------------------------------------------
# 8) Input (ibus)
# ---------------------------------------------------------------------------
# Kept engine-agnostic: ibus + m17n (covers AS/multi-script schemes) and the
# typing-booster character predictor. ibus-gtk4 is required for input methods
# to work inside GTK4 apps. CJK engines (anthy, chewing, hangul, libpinyin,
# table-* ) intentionally excluded.
RUN dnf -y install \
        ibus \
        ibus-gtk4 \
        ibus-m17n \
        ibus-typing-booster \
        langtable \
        kxkb2locale1 \
    && dnf clean all

# ---------------------------------------------------------------------------
# 9) Audio stack
# ---------------------------------------------------------------------------
# instances pulse out of plasma-pa; pulseaudio-utils gives pactl/padsp for CLI.
# phonon(+vlc backend) is the KDE media framework some widgets/apps use.
RUN dnf -y install \
        wireplumber \
        pulseaudio-utils \
        alsa-utils \
        alsa-ucm \
        alsa-sof-firmware \
        phonon-qt6 \
        phonon-qt6-backend-vlc \
    && dnf clean all

# ---------------------------------------------------------------------------
# 10) Plymouth boot splash
# ---------------------------------------------------------------------------
# Basics + the Breeze theme to match the desktop. plymouth-system-theme pulls
# the plugin/graphic-libs set; the kargs side lives in plymouth.toml (rhgb quiet).
RUN dnf -y install \
        plymouth \
        plymouth-system-theme \
        plymouth-theme-breeze \
    && dnf clean all

RUN plymouth-set-default-theme breeze

# ---------------------------------------------------------------------------
# 11) Hardware support — kernel modules, firmware, boot tooling
# ---------------------------------------------------------------------------
# kernel-modules-extra: additional filesystem/net/misc modules for wider hw.
# iwlwifi-*: Intel Wi-Fi firmware (mvm = modern, dvm = older, mld = newest gen).
# libertas + b43: Marvell / old Broadcom Wi-Fi.
# intel-vsc-firmware: Intel Visual Sensing Controller (MIPI camera).
# intel-lpmd: Intel Low Power daemon for laptop power tuning.
# usb_modeswitch: mode-switching for 3G/4G WWAN USB dongles.
# mcelog: CPU machine-check error reporting. grubby/grub2-tools: kernel arg
# management; zram-generator-defaults supplies the default zram config.
RUN dnf -y install \
        kernel-modules-extra \
        iwlwifi-mvm-firmware \
        iwlwifi-dvm-firmware \
        iwlwifi-mld-firmware \
        libertas-firmware \
        b43-fwcutter \
        b43-openfwwf \
        intel-vsc-firmware \
        intel-lpmd \
        usb_modeswitch \
        usb_modeswitch-data \
        mcelog \
        grubby \
        grub2-tools-extra \
        grub2-efi-x64-modules \
        zram-generator-defaults \
    && dnf clean all

# ---------------------------------------------------------------------------
# 12) Media, imaging & personal apps
# ---------------------------------------------------------------------------
RUN dnf -y install \
        helium-bin \
        persepolis \
        mediawriter \
        keepassxc \
        vlc \
        gthumb \
        yt-dlp \
        zenity \
        guvcview \
    && dnf clean all

# ---------------------------------------------------------------------------
# 13) Network — core, wifi/bluetooth/wwan, VPN
# ---------------------------------------------------------------------------
RUN dnf -y install \
        NetworkManager \
        NetworkManager-wifi \
        NetworkManager-bluetooth \
        NetworkManager-wwan \
        NetworkManager-config-connectivity-fedora \
        NetworkManager-openvpn \
        NetworkManager-openconnect \
        NetworkManager-pptp \
        NetworkManager-l2tp \
        NetworkManager-libreswan \
        vpnc-script \
        openssh-server \
        openssh-clients \
        bind-utils \
        ethtool \
        iw \
    && dnf clean all

# ---------------------------------------------------------------------------
# 14) Bluetooth extras (explicit per system requirement)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        bluez \
        bluez-obexd \
        iwlbluetooth-firmware \
        brcmfmac-firmware \
        atheros-firmware \
        nxpwireless-firmware \
        mt7xxx-firmware \
        iwlegacy-firmware \
        realtek-firmware \
        wireless-regdb \
    && dnf clean all

# ---------------------------------------------------------------------------
# 15) Containers
# ---------------------------------------------------------------------------
RUN dnf -y install \
        docker-ce \
        docker-compose-plugin \
        docker-buildx-plugin \
        podman \
        podman-compose \
        flatpak \
        fedora-flathub-remote \
        fedora-workstation-repositories \
        fedora-third-party \
    && dnf clean all

# ---------------------------------------------------------------------------
# 16) Printing & scanning
# ---------------------------------------------------------------------------
# cups-pk-helper = privileged print-config helper, system-config-printer-udev =
# udev hotplug for USB printers, gutenprint = extra printer driver coverage.
RUN dnf -y install \
        cups \
        cups-filters \
        cups-filters-driverless \
        cups-pk-helper \
        system-config-printer-udev \
        gutenprint \
        gutenprint-cups \
        gutenprint-libs \
        hplip \
        sane-backends \
        sane-airscan \
        ipp-usb \
        ghostscript \
    && dnf clean all

# ---------------------------------------------------------------------------
# 17) Filesystem & storage tools
# ---------------------------------------------------------------------------
# udisks2-btrfs + libblockdev-btrfs add btrfs support to the udisks/KDE stack,
# compsize is a btrfs compression analyzer.
RUN dnf -y install \
        btrfs-progs \
        udisks2-btrfs \
        libblockdev-btrfs \
        compsize \
        ntfs-3g \
        exfatprogs \
        e2fsprogs \
        dosfstools \
        xfsprogs \
        f2fs-tools \
        parted \
        gocryptfs \
        cryfs \
        fuse-sshfs \
        cifs-utils \
        samba \
        samba-usershares \
    && dnf clean all

# ---------------------------------------------------------------------------
# 18) System services & power/security
# ---------------------------------------------------------------------------
# cronie(+anacron)/crontabs = scheduling, audit(+rules) = security logging.
# Both are enabled in the services step below.
RUN dnf -y install \
        firewalld \
        firewall-config \
        earlyoom \
        cronie \
        cronie-anacron \
        crontabs \
        audit \
        audit-rules \
        thermald \
        fwupd \
        smartmontools \
        pciutils \
        usbutils \
        i2c-tools \
        lm_sensors \
        chrony \
        tuned \
        switcheroo-control \
        bluez-cups \
        fprintd \
        pcsc-lite \
        opensc \
    && dnf clean all

# ---------------------------------------------------------------------------
# 19) Developer tools
# ---------------------------------------------------------------------------
RUN dnf -y install \
        git \
        vim-enhanced \
        nano \
        zsh \
        gcc \
        gcc-c++ \
        make \
        ninja-build \
        glibc-devel \
        kernel-headers \
    && dnf clean all

# ---------------------------------------------------------------------------
# 20) CLI utilities
# ---------------------------------------------------------------------------
RUN dnf -y install \
        btop \
        fastfetch \
        fzf \
        ripgrep \
        bat \
        fd-find \
        eza \
        jq \
        zoxide \
        plocate \
        tree \
        bc \
        rsync \
        socat \
        nmap-ncat \
        tcpdump \
        traceroute \
        mtr \
        dos2unix \
        7zip \
        zip \
        unar \
        wget2 \
        curl \
        which \
        sudo \
        lsof \
        ImageMagick \
        ImageMagick-libs \
    && dnf clean all

# ---------------------------------------------------------------------------
# 21) Vulkan & graphics CLI
# ---------------------------------------------------------------------------
RUN dnf -y install \
        vulkan-tools \
        glx-utils \
        libva-utils \
    && dnf clean all

# ---------------------------------------------------------------------------
# 22) i18n / locale
# ---------------------------------------------------------------------------
RUN dnf -y install \
        glibc-all-langpacks \
        hunspell \
        hunspell-en \
    && dnf clean all

# ---------------------------------------------------------------------------
# 23) Enable Services
# ---------------------------------------------------------------------------
RUN systemctl enable NetworkManager.service plasmalogin.service docker.service earlyoom.service crond.service auditd.service -f

