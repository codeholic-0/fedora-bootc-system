#!/bin/bash
# zen-ctl — upgrade check/status/apply for zen-bootc.
# Contract (verified 2026-11-10 on bootc-vm): no-update=empty+rc0;
# available=prose+rc0; unsigned ref=error+rc1. State: /var/lib/zen-ctl/last-check.
set -u

STATE_DIR=/var/lib/zen-ctl
REPO=ghcr.io/codeholic-0/zen-bootc
SELF=$(readlink -f "$0")
dig() { jq -r "$1" 2>/dev/null; }

# Self-elevate once: bare `zen-ctl …` prompts for sudo, root/cron pass through.
for_sub() {
    [ "$(id -u)" -eq 0 ] || exec sudo -- "$SELF" "$@"
}
save_state() { mkdir -p "$STATE_DIR" && printf '%s\n' "$1" > "$STATE_DIR/last-check"; }

cmd_check() {
    for_sub check "$@"
    local out rc digest ver
    out=$(bootc upgrade --check 2>&1) && rc=0 || rc=$?
    if [ "$rc" -ne 0 ]; then
        save_state "$(date -Is) error $(printf '%s' "$out" | head -1)"
        logger -t zen-ctl "check failed (rc=$rc): $out"
        echo "zen-ctl: check failed (rc=$rc):" >&2
        printf '%s\n' "$out" >&2
        exit 2
    fi
    if [ -z "$out" ] || printf '%s' "$out" | grep -q '^No changes in:'; then
        save_state "$(date -Is) up-to-date"
        logger -t zen-ctl "check: up to date"
        echo "zen-ctl: up to date"
        return 0
    fi
    if printf '%s' "$out" | grep -q '^Update available for:'; then
        digest=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Digest: //p' | head -1)
        ver=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Version: //p' | head -1)
        save_state "$(date -Is) available ${digest:-?} ${ver:-?}"
        logger -t zen-ctl "check: update available ${ver:-} ${digest:-}"
        echo "zen-ctl: update available ${ver:-(version unknown)} ${digest:-}"
        echo "zen-ctl: update available — run 'zen-ctl upgrade'" | wall 2>/dev/null || true
        return 1
    fi
    save_state "$(date -Is) unknown $(printf '%s' "$out" | head -1)"
    logger -t zen-ctl "check: unexpected output: $out"
    echo "zen-ctl: unexpected check output (see journal)" >&2
    printf '%s\n' "$out" >&2
    exit 2
}

cmd_status() {
    for_sub status "$@"
    local sj d1 v1 tag d2 out
    sj=$(bootc status --json 2>/dev/null)
    d1=$(printf '%s' "$sj" | dig '.status.booted.image.imageDigest')
    v1=$(printf '%s' "$sj" | dig '.status.booted.image.version')
    tag=$(printf '%s' "$sj" | dig '.status.booted.image.image.image')
    d2=$(printf '%s' "$sj" | dig '.status.staged.image.imageDigest')
    echo "tracked: ${tag:-unknown}"
    echo "running: ${v1:-?} ${d1:-unknown}"
    if [ -n "$d2" ] && [ "$d2" != "null" ]; then echo "staged:  $d2"; else echo "staged:  none"; fi
    out=$(bootc upgrade --check 2>/dev/null) || { echo "remote:  check failed"; return 2; }
    if [ -z "$out" ] || printf '%s' "$out" | grep -q '^No changes in:'; then
        echo "remote:  up to date"
        save_state "$(date -Is) up-to-date"
        return 0
    fi
    if ! printf '%s' "$out" | grep -q '^Update available for:'; then
        echo "remote:  unknown output"
        save_state "$(date -Is) unknown"
        return 2
    fi
    d3=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Digest: //p' | head -1)
    v2=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Version: //p' | head -1)
    echo "remote:  update available ${v2:-} ${d3:-}"
    save_state "$(date -Is) available ${d3:-?} ${v2:-?}"
    return 1
}

cmd_upgrade() {
    for_sub upgrade "$@"
    if [ "${1:-}" = "--apply" ]; then
        exec bootc upgrade --apply
    elif [ "$#" -gt 0 ]; then
        echo "usage: zen-ctl upgrade [--apply]" >&2
        exit 2
    fi
    exec bootc upgrade
}

# --- switch: browse/roll to stable|testing tags (manual, confirmed, policy-guarded) ---
tags_list() {   # dated anchors only, newest first (rolling tags shown separately)
    podman search --list-tags "$REPO" 2>/dev/null | awk '{print $2}' \
        | grep -E '^(stable|testing)-[0-9]{8}-[0-9a-f]{7}$' | LC_ALL=C sort -r
}

switch_show() {   # read-only listing, no elevation assumed
    local f t tracked now dated
    tracked=$(bootc status --json 2>/dev/null | dig '.status.booted.image.image.image')
    [ "$tracked" = "null" ] && tracked=""
    dated=$(tags_list)
    for f in stable testing; do
        echo "$f:"
        printf '  %-30s%s\n' "$f" "$([ "$REPO:$f" = "$tracked" ] && echo '   <- current')"
        printf '%s\n' "$dated" | grep "^$f-" | head -4 | while read -r t; do
            now=""
            [ "$REPO:$t" = "$tracked" ] && now="   <- current"
            printf '  %-30s%s\n' "$t" "$now"
        done
    done
    echo "(rolling tags auto-updates; dated tags are pinned rollback anchors)"
}

cmd_switch() {
    if [ "${1:-}" = "--list" ]; then switch_show; return 0; fi
    for_sub switch "$@"
    local tag out ans
    if [ -n "${1:-}" ]; then
        tag=$1
    else
        switch_show
        printf 'tag to switch ("q"=cancel): '
        read -r tag
        case "${tag:-q}" in q|""|*[!a-zA-Z0-9._-]*) echo "zen-ctl: no tag selected"; return 0 ;; esac
    fi
    case "$tag" in latest) tag=stable ;; stable|testing) ;; *)
        tags_list | grep -qx "$tag" || { echo "zen-ctl: not a known stable/testing tag: $tag" >&2; return 2; }
        ;;
    esac
    echo "== target probe: $REPO:$tag"
    out=$(bootc upgrade --tag "$tag" --check 2>&1) || {
        printf '%s\n' "$out" >&2
        echo "zen-ctl: probe failed (registry/signature?) — not switching" >&2
        return 2
    }
    [ -n "$out" ] && printf '%s\n' "$out"
    printf 'switch to %s:%s? [y/N] ' "$REPO" "$tag"
    read -r ans
    case "$ans" in [yY]*) ;; *) echo "zen-ctl: canceled"; return 0 ;; esac
    bootc switch --transport registry "$REPO:$tag" \
        && { logger -t zen-ctl "switch: -> $tag"; echo "zen-ctl: staged $tag — reboot to enter it"; }
}

case "${1:-}" in
    check)   shift; cmd_check "$@" ;;
    status)  shift; cmd_status "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    switch)  shift; cmd_switch  "$@" ;;
    help|-h|--help|"")
        echo "usage: zen-ctl check | status | upgrade [--apply] | switch [--list|<tag>]"
        echo "  check    probe upstream digest; rc1 = update available"
        echo "  status   running/staged digest + live remote check"
        echo "  upgrade  stage an update (never automatic); --apply reboots into it"
        echo "  switch   roll the machine to a stable|testing tag (browse latest"
        echo "           per flavor, probe target, explicit confirm; --list is"
        echo "           read-only, no elevation)"
        echo "Sudo is prompted automatically; cron runs it as root weekly (Sat 22:00)." ;;
    *) echo "zen-ctl: unknown subcommand '$1'" >&2; exit 2 ;;
esac
